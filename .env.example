# Where the backend is. The only thing this file configures.
#
# Include the /api mount — endpoints.js appends /v1, so this value plus
# /v1/login must be the real path.
#
# Dev proxies through Vite (the API's CORS allows only the deployed origin, so a
# direct call from localhost is refused). A build calls it directly. Both are
# derived from this one value, so switching backends is this line and nothing else.

VITE_API_URL=https://api-newforge.forgeai.pragmatyc.com/api

# Local backend:
# VITE_API_URL=http://localhost:8080/api

# ── Demo mode ─────────────────────────────────────────────────────────────
# Turns on the prototype surfaces: every screen and panel that exists in the
# Claude Design prototype but has no API behind it yet. Additive — the modules
# that are genuinely wired (anomalies, hierarchy, asset classes, sensors) keep
# reading the real API. Leave it out, or set it to anything other than `true`,
# and the app is exactly what ships: unbuilt modules say so.
#
# Set this for a demo. Do not set it in production.
#
# VITE_DEMO_MODE=true

# ── Nothing else belongs here ─────────────────────────────────────────────
# Every other setting — transport mode, timeout, session age, AI locale, mock
# latency and error rate — has a default in src/services/config.js and is not
# configured per environment. A browser bundle has no secrets either way: every
# VITE_* value is public by construction, so no key, password or token may ever
# be added to this file or any .env the client reads.
#
# `npm run verify:auth` signs in against the real API and needs a credential,
# which is deliberately NOT here. It reads FORGE_ACCOUNT_ALIAS / FORGE_EMAIL /
# FORGE_PASSWORD (no VITE_ prefix, so they never reach the browser) and tells you
# so if they are absent. Add them to .env only if you want that check to run.
